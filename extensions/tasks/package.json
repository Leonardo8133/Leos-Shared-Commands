{
  "name": "tasks-extension",
  "displayName": "Leo's Tools - Command Tasks Runner",
  "description": "Run, organize, and reuse saved workspace commands and task scripts.",
  "version": "0.0.1",
  "publisher": "LeonardoSouza",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:tasksTree",
    "onCommand:tasks.refresh",
    "onCommand:tasks.runCommand",
    "onCommand:tasks.quickRun",
    "onCommand:tasks.runCommandById",
    "onCommand:tasks.newCommand",
    "onCommand:tasks.newFolder",
    "onCommand:tasks.editCommand",
    "onCommand:tasks.editFolder",
    "onCommand:tasks.deleteItem",
    "onCommand:tasks.moveItemUp",
    "onCommand:tasks.moveItemDown",
    "onCommand:tasks.moveItemToFolder",
    "onCommand:tasks.importFromDocumentation"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shared-commands-hub",
          "title": "Shared Commands Hub",
          "icon": "../../resources/activitybar-icon.png"
        }
      ]
    },
    "views": {
      "shared-commands-hub": [
        {
          "id": "tasksTree",
          "name": "Tasks",
          "group": "1_tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "tasks.refresh",
        "title": "Tasks: Refresh"
      },
      {
        "command": "tasks.runCommand",
        "title": "Tasks: Run Command",
        "icon": "$(play)"
      },
      {
        "command": "tasks.quickRun",
        "title": "Tasks: Quick Run",
        "icon": "$(rocket)"
      },
      {
        "command": "tasks.runCommandById",
        "title": "Tasks: Run Command By ID"
      },
      {
        "command": "tasks.newCommand",
        "title": "Tasks: New Command",
        "icon": "$(add)"
      },
      {
        "command": "tasks.newFolder",
        "title": "Tasks: New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "tasks.editCommand",
        "title": "Tasks: Edit Command",
        "icon": "$(edit)"
      },
      {
        "command": "tasks.editFolder",
        "title": "Tasks: Edit Folder",
        "icon": "$(gear)"
      },
      {
        "command": "tasks.deleteItem",
        "title": "Tasks: Delete Item",
        "icon": "$(trash)"
      },
      {
        "command": "tasks.moveItemUp",
        "title": "Tasks: Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tasks.moveItemDown",
        "title": "Tasks: Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tasks.moveItemToFolder",
        "title": "Tasks: Move To Folder",
        "icon": "$(folder-move)"
      },
      {
        "command": "tasks.refreshFromMonolith",
        "title": "Tasks: Refresh (Monolith Bridge)"
      },
      {
        "command": "tasks.importFromDocumentation",
        "title": "Tasks: Import Commands From Documentation"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "tasks.runCommand",
          "when": "view == tasksTree && viewItem == command",
          "group": "inline@1"
        },
        {
          "command": "tasks.editCommand",
          "when": "view == tasksTree && viewItem == command",
          "group": "navigation@2"
        },
        {
          "command": "tasks.editFolder",
          "when": "view == tasksTree && viewItem == folder",
          "group": "navigation@2"
        },
        {
          "command": "tasks.deleteItem",
          "when": "view == tasksTree && (viewItem == command || viewItem == folder)",
          "group": "navigation@3"
        },
        {
          "command": "tasks.moveItemUp",
          "when": "view == tasksTree && (viewItem == command || viewItem == folder)",
          "group": "navigation@4"
        },
        {
          "command": "tasks.moveItemDown",
          "when": "view == tasksTree && (viewItem == command || viewItem == folder)",
          "group": "navigation@5"
        },
        {
          "command": "tasks.moveItemToFolder",
          "when": "view == tasksTree && (viewItem == command || viewItem == folder)",
          "group": "navigation@6"
        }
      ],
      "view/title": [
        {
          "command": "tasks.newCommand",
          "when": "view == tasksTree",
          "group": "navigation@1"
        },
        {
          "command": "tasks.newFolder",
          "when": "view == tasksTree",
          "group": "navigation@2"
        },
        {
          "command": "tasks.refresh",
          "when": "view == tasksTree",
          "group": "navigation@9"
        }
      ]
    }
  }
}
